{
  "name": "cloudpulse-finops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:auth && npm run test:reset && npm run test:header && npm run test:settings && npm run test:finops",
    "test:auth": "esbuild tests/auth.smoke.jsx --bundle --jsx=automatic --platform=node --format=cjs --outfile=node_modules/.cache/auth.smoke.cjs --log-level=error && node node_modules/.cache/auth.smoke.cjs",
    "test:reset": "esbuild tests/reset.smoke.jsx --bundle --jsx=automatic --platform=node --format=cjs --outfile=node_modules/.cache/reset.smoke.cjs --log-level=error && node node_modules/.cache/reset.smoke.cjs",
    "test:finops": "esbuild tests/finops.smoke.jsx --bundle --jsx=automatic --platform=node --format=cjs --outfile=node_modules/.cache/finops.smoke.cjs --log-level=error && node node_modules/.cache/finops.smoke.cjs",
    "test:header": "esbuild tests/header.smoke.jsx --bundle --jsx=automatic --platform=node --format=cjs --outfile=node_modules/.cache/header.smoke.cjs --log-level=error && node node_modules/.cache/header.smoke.cjs",
    "test:settings": "esbuild tests/settings.smoke.jsx --bundle --jsx=automatic --platform=node --format=cjs --outfile=node_modules/.cache/settings.smoke.cjs --log-level=error && node node_modules/.cache/settings.smoke.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
