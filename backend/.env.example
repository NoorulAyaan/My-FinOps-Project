# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Local Postgres from the `postgres` container. URL-encode special characters
# in the password if it contains @ : / ? # or %.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/finops

# Generate with:  openssl rand -base64 48
# Must be different values. 16+ chars in development, 32+ in production.
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# AES-256-GCM key wrapping every stored cloud access key.
# Generate with:  openssl rand -base64 32   (must decode to exactly 32 bytes)
# Rotating this makes existing stored cloud credentials undecryptable.
ENCRYPTION_KEY=CHANGE_ME

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DEFAULT=1d
JWT_REFRESH_TTL_REMEMBER=30d
JWT_ISSUER=cloudpulse
JWT_AUDIENCE=cloudpulse-app

# Cost factor for bcrypt. 12 is ~250ms per hash on a modern laptop.
BCRYPT_ROUNDS=12

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Leave SMTP_HOST empty to print verification codes to the server console
# instead of sending them. Set the rest to send real mail.
#
# Gmail (must have 2FA on, then use an App Password, not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-char app password>
#   MAIL_FROM=CloudPulse <you@gmail.com>
#
# Resend / SendGrid / Mailgun use the same fields with their own host and port.
# MAIL_FROM must be a sender on the authenticated domain, otherwise SPF/DKIM fail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CloudPulse <no-reply@cloudpulse.local>
VERIFY_CODE_TTL_MINUTES=10
VERIFY_CODE_MAX_ATTEMPTS=5

# Password reset codes live longer than verification codes: the user has to find
# the mail, and unlike verification there is no way to simply re-request one at
# the sign-in screen.
RESET_CODE_TTL_MINUTES=15
RESET_CODE_MAX_ATTEMPTS=5

# Per-IP attempt cap on /api/auth/signup and /api/auth/signin.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000

# Set to false only when your provider terminates TLS in front of Postgres.
PGSSL=true

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Avatar files are written under UPLOAD_DIR/avatars and served from
# /uploads/avatars. In production this directory needs a persistent volume (or a
# swap to object storage); a container's ephemeral filesystem will lose avatars.
UPLOAD_DIR=./uploads
# 2 MB. Match this in the frontend if the copy there changes.
AVATAR_MAX_BYTES=2097152
